
# Kopiere diese Datei zu ".env.local" (git-ignoriert) und trage deine
# Werte aus dem Supabase-Dashboard ein: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key

# ACHTUNG: geheim, niemals mit NEXT_PUBLIC_-Präfix, niemals ins Repo commiten.
# Nur nötig für die Mitarbeitenden-Einladungsfunktion. Supabase-Dashboard ->
# Settings -> API -> "service_role" (Abschnitt "Project API keys").
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# SMTP für Systemmails (Wiedervorlagen, offene Rapporte, Lizenzhinweise).
# Absenderdomain ist arcocloud.ch – die Plattformdomain für alle Arco-Produkte.
# Bewusst nicht arcos.ch: Dort läuft die persönliche Geschäftskorrespondenz
# über Microsoft 365, und deren Zustellbarkeit soll nicht an der Reputation
# von Massen-Systemmails hängen.
SMTP_HOST=asmtp.mail.hostpoint.ch
SMTP_PORT=465
SMTP_USER=noreply@arcocloud.ch
SMTP_PASSWORD=dein-smtp-passwort
SMTP_FROM=noreply@arcocloud.ch

# Anzeigename des Absenders. Der Empfänger sieht das Produkt, nicht die
# Plattform: "ArcoTime <noreply@arcocloud.ch>". Für ein späteres Produkt
# genügt hier ein anderer Name.
SMTP_ABSENDER_NAME=ArcoTime

# Antwortadresse für Mails, die von ArcoTime selbst kommen. Muss ein echtes,
# betreutes Postfach sein – sonst lieber leer lassen als ins Leere zeigen.
SMTP_ANTWORT_AN=support@arcocloud.ch

# Basis-URL für Links in System-Mails und für die Stripe-Rückkehr-URLs.
APP_URL=https://arcotime.ch

# Schützt /api/cron/wiedervorlagen gegen fremde Aufrufe. Beliebigen langen
# Zufallswert generieren (z.B. "openssl rand -hex 32") und denselben Wert
# zusätzlich in Vercel -> Project Settings -> Environment Variables setzen.
CRON_SECRET=ein-zufaelliger-geheimer-wert

# Stripe: Lizenzmodul / Selbstregistrierung (/registrieren) + Webhook.
# Stripe-Dashboard -> Developers -> API keys (Sandbox, solange nicht live).
STRIPE_SECRET_KEY=sk_test_dein-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dein-publishable-key

# Stripe-Dashboard -> Product catalog -> "ArcoTime Lizenz" -> die beiden
# Price-IDs (Preis pro Monat / Preis pro Jahr, je mit den 3 Mengenstufen).
STRIPE_PRICE_MONATLICH=price_dein-monats-preis-id
STRIPE_PRICE_JAEHRLICH=price_dein-jahres-preis-id

# Signatur-Secret für /api/webhooks/stripe. Erst vorhanden, sobald der
# Webhook-Endpunkt im Stripe-Dashboard (Developers -> Webhooks) angelegt ist
# -> "Signing secret" dort kopieren. Ohne diesen Wert schlägt jede
# Webhook-Zustellung mit "Ungültige Signatur" fehl.
STRIPE_WEBHOOK_SECRET=whsec_dein-webhook-secret
