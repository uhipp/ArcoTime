
# Kopiere diese Datei zu ".env.local" (git-ignoriert) und trage deine
# Werte aus dem Supabase-Dashboard ein: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key

# ACHTUNG: geheim, niemals mit NEXT_PUBLIC_-Präfix, niemals ins Repo commiten.
# Nur nötig für die Mitarbeitenden-Einladungsfunktion. Supabase-Dashboard ->
# Settings -> API -> "service_role" (Abschnitt "Project API keys").
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# SMTP für den täglichen Wiedervorlagen-Reminder (aktuell Hostpoint).
SMTP_HOST=asmtp.mail.hostpoint.ch
SMTP_PORT=465
SMTP_USER=dein-postfach@example.ch
SMTP_PASSWORD=dein-smtp-passwort
SMTP_FROM=dein-postfach@example.ch

# Basis-URL für Links in System-Mails.
APP_URL=https://arco-time.vercel.app

# Schützt /api/cron/wiedervorlagen gegen fremde Aufrufe. Beliebigen langen
# Zufallswert generieren (z.B. "openssl rand -hex 32") und denselben Wert
# zusätzlich in Vercel -> Project Settings -> Environment Variables setzen.
CRON_SECRET=ein-zufaelliger-geheimer-wert
